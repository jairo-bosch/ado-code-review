#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export PATH="${CARGO_HOME:-"$HOME/.cargo"}/bin:$PATH"
case "$(uname -s):$(uname -m)" in
    Linux:x86_64)
        arch=x86_64
        just_hash=409044617b6f06517c1035e55ca38c8c856ff8b650e41bc2aa1ef82d5903a23e ;;
    Linux:aarch64)
        arch=aarch64
        just_hash=23871b1702bfd550fb5f901778fd4290ecf2ee034a45a889fbe96d89b188086d ;;
    *) printf 'Tool bootstrap supports Linux x86_64 and aarch64\n' >&2; exit 1 ;;
esac

just_version=1.59.0
if ! command -v just >/dev/null || [[ "$(just --version)" != "just $just_version" ]]; then
    bash scripts/install-release casey/just "$just_version" \
        "just-$just_version-$arch-unknown-linux-musl.tar.gz" just "$just_hash"
fi

exec just setup
